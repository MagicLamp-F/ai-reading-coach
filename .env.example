TIMEZONE=Asia/Shanghai
HTTP_TIMEOUT_SECONDS=20
MAX_DAILY_SEARCH_CALLS=6
MAX_DAILY_MODEL_CALLS=4
DAILY_RECOMMENDATION_COUNT=1
