[Unit]
Description=AI Reading Coach weekly reflection report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/ai-reading-coach
EnvironmentFile=/home/ubuntu/projects/ai-reading-coach/.env
ExecStart=/usr/bin/python3 -m app.cli run-weekly-report
