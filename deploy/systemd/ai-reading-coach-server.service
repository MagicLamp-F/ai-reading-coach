[Unit]
Description=AI Reading Coach feedback server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/ai-reading-coach
EnvironmentFile=/home/ubuntu/projects/ai-reading-coach/.env
ExecStart=/usr/bin/python3 -m app.cli run-server --host 0.0.0.0 --port 8010
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
